{
  "name": "@happyvertical/pdf",
  "version": "0.66.0",
  "description": "Node.js PDF extraction, OCR fallback, image extraction, and PDF generation utilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.13.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pdf",
    "ocr",
    "text-extraction",
    "pdf-generation",
    "html-to-pdf",
    "markdown-to-pdf",
    "unpdf"
  ],
  "publishConfig": {
    "registry": "https://npm.happyvertical.com/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/happyvertical/pdf.git"
  },
  "bugs": {
    "url": "https://github.com/happyvertical/pdf/issues"
  },
  "homepage": "https://github.com/happyvertical/pdf#readme",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run --testTimeout 120000",
    "test:coverage": "vitest run --coverage --testTimeout 120000",
    "test:watch": "vitest --testTimeout 120000",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write src/",
    "docs:api": "typedoc --options typedoc.json",
    "docs:api:check": "tsx scripts/check-generated-api-docs.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "dev": "npm run build:watch & npm run test:watch",
    "changeset": "changeset",
    "changeset:auto": "npx tsx scripts/auto-changeset.ts",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@happyvertical/ocr": "^0.61.1",
    "@happyvertical/utils": "^0.80.1",
    "@napi-rs/canvas": "0.1.100",
    "marked": "^18.0.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.1.200",
    "puppeteer-core": "^25.3.0",
    "unpdf": "^1.6.2"
  },
  "optionalDependencies": {
    "@kreuzberg/node": "^4.10.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "lefthook": "2.1.10",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10"
  }
}
